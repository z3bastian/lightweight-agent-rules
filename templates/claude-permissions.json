{
  "permissions": {
    "deny": [
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout .)",
      "Bash(git checkout -- *)",
      "Read(//**/.env)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Edit(//**/*.pem)",
      "Edit(//**/*.key)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git restore *)",
      "Bash(gh pr *)",
      "Read(//**/.env.*)"
    ]
  }
}
